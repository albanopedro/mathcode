# Copie para .env (na raiz do Mathcode) e ajuste. O .env nunca vai para o Git.
# Todas as variáveis são opcionais; os valores abaixo são os padrões.

# development | test | production
MATHCODE_ENVIRONMENT=development

# Documentação interativa da API em /api/docs.
# Sem valor: ligada fora de produção e desligada em produção.
# MATHCODE_DOCS_ENABLED=true

# Processos que executam os cálculos (1 a 16).
# MATHCODE_WORKERS=2

# Segundos que um cálculo pode levar antes de ser interrompido.
# MATHCODE_CALCULATION_TIMEOUT=5

# Segundos que um pedido espera por um processo livre antes do HTTP 503.
# MATHCODE_QUEUE_TIMEOUT=10

# IA opcional para frases que as regras locais não entendem (ADR 0009).
# none: tudo local (padrão). opencode: usa o OpenCode instalado, com um modelo
# gratuito, só nos pedidos em que o usuário marcar "Permitir IA".
# MATHCODE_AI_PROVIDER=none

# Só modelos gratuitos: opencode/<nome>-free ou opencode/big-pickle.
# Qualquer outro valor impede o servidor de iniciar.
# MATHCODE_AI_MODEL=opencode/space-bunny-free

# Segundos que uma consulta à IA pode levar (5 a 300).
# MATHCODE_AI_TIMEOUT=90
